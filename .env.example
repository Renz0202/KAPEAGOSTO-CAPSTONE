# Copy this file to `.env` and fill in real values (never commit `.env`).
# SMTP settings for PHPMailer
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=youraccount@gmail.com
MAIL_PASSWORD=your-app-password-here
# Optional: force auth type (LOGIN, PLAIN, XOAUTH2)
MAIL_AUTH_TYPE=
MAIL_FROM_ADDRESS=youraccount@gmail.com
MAIL_FROM_NAME=KAPEAGOSTO
MAIL_REPLY_TO=youraccount@gmail.com

# Debug level (0=off, 2=client/server messages)
MAIL_DEBUG=0

# TLS certificate verification (keep TRUE in production if possible)
MAIL_VERIFY_PEER=false
MAIL_VERIFY_PEER_NAME=false
MAIL_ALLOW_SELF_SIGNED=true

# Base URL (optional). If set, reset links will use this explicitly.
APP_URL=http://localhost/KAPEAGOSTO

# Stripe test configuration
# STRIPE_SECRET=
# STRIPE_PUBLISHABLE=
# STRIPE_WEBHOOK_SECRET=

# Google reCAPTCHA configuration
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# DKIM signing (optional; improves deliverability when configured)
# Provide absolute path to your DKIM private key file. Selector and domain must match your DNS records.
MAIL_DKIM_DOMAIN=
MAIL_DKIM_SELECTOR=
MAIL_DKIM_PRIVATE=
MAIL_DKIM_IDENTITY=
