DirectoryIndex pages/index.php index.html
RewriteEngine On

RewriteRule ^$ pages/index.php [L,QSA]
RewriteRule ^legacy_routes/ - [F,L]

RewriteRule ^index\.php$ pages/index.php [L,QSA]
RewriteRule ^welcome\.php$ pages/welcome.php [L,QSA]
RewriteRule ^dashboard\.php$ pages/dashboard.php [L,QSA]
RewriteRule ^no_access\.php$ pages/no_access.php [L,QSA]
RewriteRule ^profile\.php$ pages/profile.php [L,QSA]
RewriteRule ^notifications\.php$ pages/notifications.php [L,QSA]
RewriteRule ^maintenance\.php$ pages/maintenance.php [L,QSA]
RewriteRule ^settings\.php$ settings/settings.php [L,QSA]
RewriteRule ^manager_settings\.php$ settings/manager_settings.php [L,QSA]

RewriteRule ^login\.php$ auth/login.php [L,QSA]
RewriteRule ^logout\.php$ auth/logout.php [L,QSA]
RewriteRule ^auth_login\.php$ auth/auth_login.php [L,QSA]
RewriteRule ^forgot_password\.php$ auth/forgot_password.php [L,QSA]
RewriteRule ^reset_password\.php$ auth/reset_password.php [L,QSA]
RewriteRule ^send_reset\.php$ auth/send_reset.php [L,QSA]
RewriteRule ^check_identifier\.php$ auth/check_identifier.php [L,QSA]

RewriteRule ^users\.php$ users/users.php [L,QSA]
