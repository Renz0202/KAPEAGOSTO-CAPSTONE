RewriteRule ^delete_user\.php$ users/delete_user.php [L,QSA]
RewriteRule ^delete_user_permanent\.php$ users/delete_user_permanent.php [L,QSA]
RewriteRule ^activate_user\.php$ users/activate_user.php [L,QSA]

RewriteRule ^categories\.php$ catalog/categories.php [L,QSA]
RewriteRule ^add_category\.php$ catalog/add_category.php [L,QSA]
RewriteRule ^edit_category\.php$ catalog/edit_category.php [L,QSA]
RewriteRule ^delete_category\.php$ catalog/delete_category.php [L,QSA]
RewriteRule ^items\.php$ catalog/items.php [L,QSA]
RewriteRule ^add_item\.php$ catalog/add_item.php [L,QSA]
