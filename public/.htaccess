RewriteRule ^orders\.php$ orders/orders.php [L,QSA]
RewriteRule ^new_order\.php$ orders/new_order.php [L,QSA]
RewriteRule ^place_order\.php$ orders/place_order.php [L,QSA]
RewriteRule ^save_order\.php$ orders/save_order.php [L,QSA]
